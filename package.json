{
  "name": "wedding-hanbang",
  "version": "0.1.0",
  "private": true,
  "description": "웨딩한방 모노레포 — 웹 + 모바일 + 공유 패키지",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@hanbang/web",
    "dev:mobile": "turbo run dev --filter=@hanbang/mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@hanbang/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "supabase:version": "supabase --version",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:migrations": "supabase migration list --linked",
    "supabase:push:dry": "supabase db push --linked --dry-run",
    "supabase:push": "node ./scripts/supabase-release-fence.mjs --refuse-direct-push",
    "supabase:setup:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-safe-setup.ps1",
    "supabase:check:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-safe-check.ps1",
    "supabase:baseline:history": "node ./scripts/supabase-release-fence.mjs --refuse-direct-push",
    "supabase:normalize:history": "node ./scripts/supabase-release-fence.mjs --refuse-direct-push",
    "supabase:apply:pending": "node ./scripts/supabase-release-fence.mjs --refuse-direct-push",
    "supabase:ship:safe": "node ./scripts/supabase-release-fence.mjs --refuse-direct-push",
    "supabase:release:fence": "node ./scripts/supabase-release-fence.mjs",
    "supabase:release:fence:remote": "node ./scripts/supabase-release-fence.mjs --remote",
    "supabase:security:probe": "node ./scripts/supabase-anon-probe.mjs",
    "supabase:vendor-security:probe": "node ./scripts/vendor-public-rls-probe.mjs",
    "community:media:audit": "node ./scripts/audit-community-media-urls.mjs",
    "amora:costs": "node ./scripts/amora-cost-report.mjs",
    "amora:db:backup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/amora-db-backup.ps1",
    "amora:db:verify-backup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/amora-db-verify-backup.ps1",
    "amora:db:jsonb-roundtrip": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/amora-db-verify-backup.ps1",
    "amora:db:test-backup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/tests/amora-db-backup-e2e.ps1",
    "amora:db:test-preview": "node ./apps/web/scripts/amora-preview-integration.mjs",
    "qa:local": "node ./scripts/verify-local.mjs",
    "qa:live": "node ./scripts/live-smoke-test.mjs",
    "qa:live:local": "node ./scripts/live-smoke-test.mjs --base-url=http://localhost:3000",
    "mobile:release-check": "node ./scripts/mobile-release-readiness.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@sentry/nextjs": "^10.63.0",
    "pg": "8.22.0",
    "playwright-core": "^1.61.0",
    "supabase": "2.106.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.7.0"
  }
}
