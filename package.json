{
  "name": "wedding-hanbang",
  "version": "0.1.0",
  "private": true,
  "description": "웨딩한방 모노레포 — 웹 + 모바일 + 공유 패키지",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@hanbang/web",
    "dev:mobile": "turbo run dev --filter=@hanbang/mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@hanbang/web",
    "lint": "turbo run lint",
    "typecheck": "pnpm ingest:typecheck && turbo run typecheck",
    "test": "pnpm test:ingest && node --test ./scripts/tests/amora-conversation-eval.test.mjs ./scripts/tests/amora-production-env.test.mjs ./scripts/tests/amora-runtime-env-contract.test.mjs ./scripts/tests/local-qa-environment.test.mjs ./scripts/tests/repository-handoff-docs.test.mjs ./scripts/tests/git-hooks-autoinstall.test.mjs ./scripts/tests/wedding-code-research-safety.test.mjs ./scripts/tests/amora-db-current-baseline-restore.test.mjs ./scripts/tests/storage-signed-upload-drain-evidence.test.mjs ./scripts/tests/production-write-fence-evidence.test.mjs ./scripts/tests/post-push-platform-evidence.test.mjs ./scripts/tests/production-windows-toolchain.test.mjs ./scripts/tests/production-external-gate-cli.test.mjs ./scripts/tests/production-external-gate-provenance.test.mjs ./scripts/tests/production-write-fence-finalizer.test.mjs ./scripts/tests/sql-read-only-envelope.test.mjs ./scripts/tests/vendor-public-rls-probe.test.mjs ./scripts/tests/supabase-release-fence.test.mjs ./scripts/tests/supabase-production-release.test.mjs ./scripts/tests/supabase-service-destination.test.mjs ./scripts/tests/successor-release-evidence-contract.test.mjs ./scripts/tests/disclosure-count-consistency.test.mjs ./scripts/tests/mobile-web-link-targets.test.mjs ./scripts/tests/ci-signal-integrity.test.mjs ./scripts/tests/disclosure-round-pin.test.mjs && turbo run test",
    "ingest": "tsx ./scripts/ingest/index.ts",
    "ingest:fixed8:ground-truth": "tsx ./scripts/ingest/build-fixed-eight-ground-truth.ts",
    "ingest:typecheck": "tsc -p ./scripts/ingest/tsconfig.json --noEmit",
    "test:ingest": "tsx --test ./scripts/ingest/__tests__/*.test.ts",
    "price:demo:seed": "tsx ./scripts/ingest/price-demo-seed.ts",
    "supabase:version": "supabase --version",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:migrations": "supabase migration list --linked",
    "supabase:push:dry": "supabase db push --linked --dry-run",
    "supabase:push": "node ./scripts/supabase-release-fence.mjs --refuse-direct-push",
    "supabase:setup:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-safe-setup.ps1",
    "supabase:check:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-safe-check.ps1",
    "supabase:baseline:history": "node ./scripts/supabase-release-fence.mjs --refuse-direct-push",
    "supabase:normalize:history": "node ./scripts/supabase-release-fence.mjs --refuse-direct-push",
    "supabase:apply:pending": "node ./scripts/supabase-release-fence.mjs --refuse-direct-push",
    "supabase:ship:safe": "node ./scripts/supabase-release-fence.mjs --refuse-direct-push",
    "supabase:release:fence": "node ./scripts/supabase-release-fence.mjs",
    "supabase:release:fence:remote": "node ./scripts/supabase-release-fence.mjs --remote",
    "supabase:release:apply": "node ./scripts/supabase-production-release.mjs",
    "supabase:release:storage-drain": "node ./scripts/capture-storage-signed-upload-drain-evidence.mjs",
    "supabase:release:external-evidence": "node ./scripts/collect-production-external-gate-evidence.mjs",
    "supabase:release:test": "node --test ./scripts/tests/amora-db-current-baseline-restore.test.mjs ./scripts/tests/storage-signed-upload-drain-evidence.test.mjs ./scripts/tests/production-write-fence-evidence.test.mjs ./scripts/tests/post-push-platform-evidence.test.mjs ./scripts/tests/production-windows-toolchain.test.mjs ./scripts/tests/production-external-gate-cli.test.mjs ./scripts/tests/production-external-gate-provenance.test.mjs ./scripts/tests/production-write-fence-finalizer.test.mjs ./scripts/tests/sql-read-only-envelope.test.mjs ./scripts/tests/vendor-public-rls-probe.test.mjs ./scripts/tests/supabase-release-fence.test.mjs ./scripts/tests/supabase-production-release.test.mjs ./scripts/tests/supabase-service-destination.test.mjs ./scripts/tests/successor-release-evidence-contract.test.mjs",
    "supabase:security:probe": "node ./scripts/supabase-anon-probe.mjs",
    "supabase:vendor-security:probe": "node ./scripts/vendor-public-rls-probe.mjs",
    "prepare": "node ./scripts/install-git-hooks.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "community:media:audit": "node ./scripts/audit-community-media-urls.mjs",
    "audit:production": "node ./scripts/audit/production-readiness-audit.mjs",
    "audit:vendor-merge": "node ./scripts/audit/vendor-merge-review.mjs",
    "audit:distribution": "tsx ./scripts/audit/distribution-claims-audit.mjs",
    "amora:costs": "node ./scripts/amora-cost-report.mjs",
    "amora:eval": "node ./scripts/amora-conversation-eval.mjs",
    "amora:eval:live": "node ./scripts/amora-conversation-eval.mjs --base-url=https://hanbang.ai --samples=1",
    "amora:db:backup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/amora-db-backup.ps1",
    "amora:db:verify-backup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/amora-db-verify-backup.ps1",
    "amora:db:jsonb-roundtrip": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/amora-db-verify-backup.ps1",
    "amora:db:test-backup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/tests/amora-db-backup-e2e.ps1",
    "amora:db:test-preview": "node ./apps/web/scripts/amora-preview-integration.mjs",
    "amora:db:test-engine-v2": "node ./apps/web/scripts/amora-engine-v2-hosted-integration.mjs",
    "qa:local": "node ./scripts/verify-local.mjs",
    "qa:live": "node ./scripts/live-smoke-test.mjs",
    "qa:live:local": "node ./scripts/live-smoke-test.mjs --base-url=http://localhost:3000",
    "mobile:release-check": "node ./scripts/mobile-release-readiness.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@sentry/nextjs": "^10.66.0",
    "@supabase/supabase-js": "^2.95.3",
    "@types/node": "^20.19.39",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "~19.1.17",
    "jszip": "3.10.1",
    "mammoth": "1.12.0",
    "openai": "6.46.0",
    "pdf-parse": "1.1.1",
    "pg": "8.22.0",
    "playwright-core": "^1.61.0",
    "saxes": "6.0.0",
    "sharp": "0.34.5",
    "supabase": "2.106.0",
    "tsx": "4.23.1",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.3.6"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.7.0"
  }
}
