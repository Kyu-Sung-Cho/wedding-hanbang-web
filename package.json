{
  "name": "wedding-hanbang",
  "version": "0.1.0",
  "private": true,
  "description": "웨딩한방 모노레포 — 웹 + 모바일 + 공유 패키지",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@hanbang/web",
    "dev:mobile": "turbo run dev --filter=@hanbang/mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@hanbang/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "supabase:version": "supabase --version",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:migrations": "supabase migration list --linked",
    "supabase:push:dry": "supabase db push --linked --dry-run",
    "supabase:push": "supabase db push --linked",
    "supabase:setup:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-safe-setup.ps1",
    "supabase:check:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-safe-check.ps1",
    "supabase:baseline:history": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-baseline-history.ps1",
    "supabase:normalize:history": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-normalize-legacy-history.ps1",
    "supabase:apply:pending": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-pending.ps1",
    "supabase:ship:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-ship-safe.ps1",
    "supabase:security:probe": "node ./scripts/supabase-anon-probe.mjs",
    "community:media:audit": "node ./scripts/audit-community-media-urls.mjs",
    "amora:costs": "node ./scripts/amora-cost-report.mjs",
    "qa:local": "node ./scripts/verify-local.mjs",
    "qa:live": "node ./scripts/live-smoke-test.mjs",
    "qa:live:local": "node ./scripts/live-smoke-test.mjs --base-url=http://localhost:3000",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@sentry/nextjs": "^10.47.0",
    "playwright-core": "^1.61.0",
    "supabase": "2.106.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.13",
      "postcss": "8.5.14",
      "shell-quote@<=1.8.3": "1.8.4",
      "ws@<8.21.0": "8.21.0",
      "undici@<6.27.0": "6.27.0",
      "tar@<=7.5.15": "7.5.19",
      "dompurify@<=3.4.10": "3.4.11",
      "js-yaml@>=3.0.0 <3.15.0": "3.15.0",
      "js-yaml@>=4.0.0 <4.2.0": "4.3.0",
      "@babel/core@<=7.29.0": "7.29.7",
      "uuid@<11.1.1": "11.1.1",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "fast-uri": "3.1.2"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
