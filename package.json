{
  "name": "wedding-hanbang",
  "version": "0.1.0",
  "private": true,
  "description": "웨딩한방 모노레포 — 웹 + 모바일 + 공유 패키지",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@hanbang/web",
    "dev:mobile": "turbo run dev --filter=@hanbang/mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@hanbang/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "supabase:version": "supabase --version",
    "supabase:baseline:core": "node ./scripts/run-reviewed-powershell.mjs ./scripts/supabase-reconcile-core-baseline.ps1",
    "supabase:ship:safe": "node ./scripts/run-reviewed-powershell.mjs ./scripts/supabase-ship-safe.ps1",
    "supabase:fence": "node ./scripts/run-reviewed-powershell.mjs ./scripts/supabase-write-fence.ps1",
    "supabase:recovery:safe": "node ./scripts/supabase-recovery-safe.mjs",
    "supabase:recovery:test": "node --test ./scripts/supabase-recovery-safe.test.mjs",
    "supabase:security:probe": "node ./scripts/supabase-anon-probe.mjs",
    "supabase:lifecycle:smoke": "node ./scripts/supabase-lifecycle-smoke.mjs",
    "community:media:audit": "node ./scripts/audit-community-media-urls.mjs",
    "security:secrets": "node ./scripts/scan-tracked-secrets.mjs",
    "amora:costs": "node ./scripts/amora-cost-report.mjs",
    "amora:openai:smoke": "node ./scripts/amora-openai-smoke.mjs",
    "qa:local": "node ./scripts/verify-local.mjs",
    "qa:live": "node ./scripts/live-smoke-test.mjs",
    "qa:live:local": "node ./scripts/live-smoke-test.mjs --base-url=http://localhost:3000",
    "mobile:release-check": "node ./scripts/mobile-release-readiness.mjs",
    "mobile:store-release-check": "node ./scripts/mobile-release-readiness.mjs --store-ready",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@sentry/nextjs": "^10.65.0",
    "playwright-core": "^1.61.0",
    "supabase": "2.106.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.7.0"
  }
}
