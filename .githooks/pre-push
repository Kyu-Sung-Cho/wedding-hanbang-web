#!/bin/sh
# push 전 로컬 게이트.
#
# 왜 필요한가: 2026-07-27에 다른 브랜치 작업을 편입하면서 소스 변경만 골라 버리고
# 그 변경과 짝인 테스트를 안 돌린 채 커밋·푸시해 게이트를 깼다. 아무것도 막지 않았다.
# CI가 같은 검사를 하지만 이 저장소의 CI는 **설계상 영구 빨간불**이라
# (`production_readiness` 잡이 항상 exit 1) 집계 결과만 보고는 판단할 수 없다.
# 그래서 로컬에서 한 번 막는다.
#
# 비용: turbo가 캐시하므로 이미 돌려 본 상태면 몇 초다. 바뀐 게 있을 때만 실제로 돈다.
#
# 건너뛰기(정말 필요할 때만):
#   HANBANG_SKIP_PREPUSH=1 git push
#
# 설치(컴퓨터마다 한 번):
#   npx pnpm@11.7.0 hooks:install

set -e

if [ "${HANBANG_SKIP_PREPUSH}" = "1" ]; then
  echo "[pre-push] HANBANG_SKIP_PREPUSH=1 — 게이트를 건너뛴다."
  exit 0
fi

echo "[pre-push] typecheck · lint · test (turbo 캐시 적중 시 수 초)"

# 네트워크·운영 DB를 건드리는 스크립트 테스트는 제외한다 — 오프라인에서도 돌아야 한다.
# 그건 CI와 `pnpm test`가 담당한다.
if ! npx pnpm@11.7.0 exec turbo run typecheck lint test --output-logs=errors-only; then
  echo ""
  echo "[pre-push] 게이트 실패 — 푸시를 막았다."
  echo "           고친 뒤 다시 시도하거나, 정말 필요하면 HANBANG_SKIP_PREPUSH=1 로 넘긴다."
  exit 1
fi

echo "[pre-push] 통과."
