{
  "name": "@hanbang/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node ./scripts/start-expo-dev.mjs --clear",
    "dev:ios": "node ./scripts/start-expo-dev.mjs --ios --clear",
    "dev:android": "node ./scripts/start-expo-dev.mjs --android --clear",
    "build": "expo export --platform all --output-dir .expo/export-smoke --clear",
    "test": "node --test ./src/__tests__/*.test.mjs",
    "eas:init": "pnpm dlx eas-cli init",
    "eas:build:ios": "pnpm dlx eas-cli build --platform ios --profile production",
    "eas:build:android": "pnpm dlx eas-cli build --platform android --profile production",
    "eas:build:all": "pnpm dlx eas-cli build --platform all --profile production",
    "eas:submit:ios": "pnpm dlx eas-cli submit --platform ios --profile production",
    "eas:submit:android": "pnpm dlx eas-cli submit --platform android --profile production",
    "release:check": "node ../../scripts/mobile-release-readiness.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .expo"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@hanbang/design-tokens": "workspace:*",
    "@hanbang/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.95.3",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.0",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.545.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.1.22",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "^9.39.4",
    "@types/react": "~19.1.0",
    "async-limiter": "1.0.1",
    "eslint": "^9.39.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.62.1"
  }
}
