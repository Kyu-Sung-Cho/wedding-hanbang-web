# Expo 앱 환경변수 — EXPO_PUBLIC_* 만 클라이언트 번들에 포함됨
# 실제 값은 .env.local 에 넣고 git ignore

EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...

# Required for preview/production EAS builds. Use that environment's exact
# HTTPS web origin only (no path, query, fragment, or credentials).
# Local development may omit it and explicitly falls back to localhost:3000.
EXPO_PUBLIC_SITE_URL=https://hanbang.ai

# Enables silent token refresh/rotation listeners after rollout approval.
# User consent remains a separate default-off DB preference toggled in Settings.
EXPO_PUBLIC_PUSH_REGISTRATION_ENABLED=false

# Controlled beta is text-only. This public flag only reveals media controls;
# web API upload/publish routes still require their separate server-only flag.
EXPO_PUBLIC_COMMUNITY_MEDIA_PUBLISHING_ENABLED=false

# Keep Kakao hidden until the provider is enabled in both Supabase Auth and
# the Kakao developer console. Google follows the same rule: enable the Google
# provider in Supabase Auth and register the app's client ID and redirect URI in
# the Google Cloud Console before setting its flag to true. A button that cannot
# complete a sign-in is worse than no button. Apple is enabled by default on
# native builds; set its flag to false only for an emergency provider shutdown.
EXPO_PUBLIC_KAKAO_OAUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_OAUTH_ENABLED=false
EXPO_PUBLIC_APPLE_OAUTH_ENABLED=true

# Cloudflare Turnstile 위젯의 공개 site key. 비밀 key는 웹 서버 환경에만 설정합니다.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

EXPO_PUBLIC_SENTRY_DSN=
# 아래 3개는 EAS build 전용입니다. SENTRY_AUTH_TOKEN은 절대 EXPO_PUBLIC_*로 만들지 마세요.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
EXPO_PUBLIC_POSTHOG_KEY=
