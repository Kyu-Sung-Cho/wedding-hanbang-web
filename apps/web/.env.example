# =============================================
# 웨딩한방 웹 환경변수 샘플
# =============================================
# .env.local 로 복사 후 실제 값으로 채워 사용:
#   cp .env.example .env.local
# NEXT_PUBLIC_* 접두사가 붙은 값만 브라우저로 노출됩니다.
# =============================================


# ----- Supabase (필수) -------------------------
# 공유 Supabase 프로젝트 (모바일 앱과 동일)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
# Production build gate: exact distinct approved-vendor count and SHA-256 of
# UTF-8 JSON.stringify(the ordinal-sorted unique vendor_slug list). Both are
# release evidence, not operator-chosen safety margins; leave blank otherwise.
PRICE_CATALOG_EXPECTED_PUBLISHED_VENDOR_COUNT=
PRICE_CATALOG_EXPECTED_PUBLISHED_VENDOR_SLUGS_SHA256=
# Vendor disclosure production authorization is intentionally not represented
# by an environment variable. A public repository digest is not a signature;
# production stays fail-closed until the external signed verifier is built.
# Service Role 키 — RLS 우회용. 브라우저에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...
# Supabase Management API 개인 액세스 토큰(PAT)은 사용자 계정 전체 권한의 장기
# 자격증명이므로 이 파일이나 .env.local에 저장하지 않는다. 운영자 스크립트를 실행할
# 때만 현재 프로세스의 SUPABASE_ACCESS_TOKEN으로 주입하고, 종료 즉시 환경에서 지운다.
# Service-role destination fence. The URL and ref are a singleton allowlist.
# For production runtime writes, the confirmation must exactly be
# RUNTIME_WRITE:<SUPABASE_PRODUCTION_PROJECT_REF>. It is not a secret.
SUPABASE_EXPECTED_URL=https://your-project-ref.supabase.co
SUPABASE_EXPECTED_PROJECT_REF=your-project-ref
SUPABASE_PRODUCTION_PROJECT_REF=your-production-project-ref
SUPABASE_PRODUCTION_WRITE_CONFIRM=
# Required by every /api/cron/* route. Generate a separate 32+ character
# unpadded base64url (or hex) value with a cryptographic RNG; maximum 512.
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
# HMAC key for pseudonymous rate-limit bucket identifiers. Use a distinct
# random value of at least 32 characters in production; rotating it resets
# active rate-limit windows.
RATE_LIMIT_KEY_SECRET=
# Distinct 32+ character base64url secret used only for AES-256-GCM pending
# preregistration payloads and keyed email lookup digests. Rotating it makes
# outstanding 30-minute confirmation links unreadable; never reuse another key.
PREREGISTRATION_INTENT_ENCRYPTION_KEY=
# Purges only expired pending intents. Keep false until the cron schedule and
# alerting are reviewed; issuance also opportunistically deletes a bounded set.
PREREGISTRATION_PENDING_PURGE_ENABLED=false
# Separate secret for stable pseudonymous labels in the local cost report.
# Never reuse the service-role credential as an HMAC key.
AMORA_COST_REPORT_PSEUDONYM_KEY=
# 데모 쿠키 서명 전용 32바이트 이상 랜덤 비밀값. 운영에서는 다른 키의
# fallback에 기대지 말고 별도 값으로 설정합니다.
DEMO_SESSION_SECRET=
# Release-evaluation quota bypass credential. Use a separate random 32+ byte
# value and never reuse demo, rate-limit, cron, or admin secrets.
AMORA_EVAL_SECRET=
# Canonical internal server-to-server authentication for Amora vendor lookup,
# recommendation, and evidence profile APIs. Generate a distinct 32+ character
# unpadded base64url (or hex) value with a cryptographic RNG; maximum 512. Send
# it only as `X-Internal-Token` and never expose it to a browser bundle.
INTERNAL_API_TOKEN=
# Legacy deployment compatibility only. Prefer leaving this unset. If both
# variables are present they must be identical, otherwise requests fail closed.
VENDOR_INTERNAL_TOKEN=

# Preview-only fail-closed mode. Set true only in Vercel Preview.
# It disables public landing Supabase effects and returns 503 for every /api/* request,
# even if live Supabase variables are accidentally injected. Never enable in Production.
NEXT_PUBLIC_PREVIEW_STUB_MODE=false


# ----- 도메인 / 사이트 URL ---------------------
# OAuth 콜백, 이메일 발송 시 링크에 사용
NEXT_PUBLIC_SITE_URL=https://hanbang.ai


# ----- WeddingCode local research preview -----
# Local development only. The route also requires NODE_ENV=development and
# stays 404 in Preview/Production. It performs no network or browser storage.
WEDDING_CODE_RESEARCH_PREVIEW=false


# ----- OpenAI GPT-5.6 (필수) --------------------
# AI 채팅(아모라)과 서버의 AI 보조 기능에 사용합니다.
# 운영 안전 게이트를 모두 통과하기 전에는 false로 유지합니다.
# 키만 등록해도 자동 활성화되지 않습니다.
AMORA_OPENAI_ENABLED=false
# Extra summarization/profile/extraction calls are disabled by default to avoid
# hidden fan-out cost. Enable only after a queued worker and separate budget exist.
AMORA_AUXILIARY_MEMORY_ENABLED=false
# Proactive care email is a separate external side effect and stays off until
# roster-churn and delivery canaries pass.
AMORA_CARE_OUTBOUND_ENABLED=false
# In-app proactive care (Amora speaks first inside the chat) is a separate switch
# from the email side effect above. It has no external delivery, so it can be
# enabled on its own; the whole moment loop stays silent while this is false.
AMORA_PROACTIVE_CHAT_ENABLED=false
# Community auto-comments are a separate public side effect. Keep them off until
# moderation, cost, and deletion canaries have passed.
AMORA_COMMUNITY_AI_COMMENT_ENABLED=false
# Destructive raw-log retention stays off until the 90-day policy, backup,
# restore rehearsal, and production canary have explicit approval.
AI_LOG_RETENTION_CRON_ENABLED=false
# Account-deletion intake is a separate fail-closed boundary. Keep both intake
# and progression off until shared-media policy, legal retention, completion
# notification, backup replay, and the manual-review owner/SLA are approved.
ACCOUNT_DELETION_INTAKE_ENABLED=false
ACCOUNT_DELETION_CRON_ENABLED=false
# Temporary release-maintenance gate. Exact `true` returns 503 for unsafe
# /api methods. Keep false normally; enable and redeploy before the final backup.
PRODUCTION_WRITE_FENCE_ENABLED=false
OPENAI_API_KEY=
OPENAI_AMORA_PRIMARY_MODEL=gpt-5.6-terra
OPENAI_AMORA_FAST_MODEL=gpt-5.6-luna
OPENAI_AMORA_PRIMARY_REASONING_EFFORT=none
OPENAI_AMORA_FAST_REASONING_EFFORT=none

# ----- Amora profile memory ---------------------
# off: disabled / conservative: explicit preferences only / full: includes sensitive fields
AMORA_PROFILE_MEMORY_MODE=conservative


# ----- Resend (사전등록 / 가입 확인 메일) -----
# 없어도 앱은 동작 (이메일 발송만 skip)
RESEND_API_KEY=re_xxx...


# ----- Launch 모드 -----------------------------
# "coming_soon" 이면 랜딩만 노출되고 로그인/앱 접근 차단
# 그 외 값(또는 미설정) — 정상 서비스 모드
NEXT_PUBLIC_LAUNCH_MODE=


# ----- 관리자 페이지 비밀번호 ------------------
# /admin 접속 시 요구. 공백·제어문자 없는 32자 이상 고유 시크릿만 허용.
ADMIN_PASSWORD=
# 최초 관리자 생성 작업 창에서만 잠깐 true. 운영 기본값은 반드시 false.
ADMIN_INITIAL_SETUP_ENABLED=false


# ----- 아모라 서비스 계정 ID (커뮤니티 AI 댓글용)
# 서버: 커뮤니티 AI 댓글 작성자 ID
AMORA_SERVICE_USER_ID=00000000-0000-0000-0000-000000000000
# 클라이언트: 커뮤니티에서 아모라 유저 판별용


# ----- NAVER API HUB (장소/사진 검색) -----
# 서버 전용. 개인정보 처리 고지·계약·운영 승인이 끝난 뒤에만 true로 전환합니다.
NAVER_PLACE_SEARCH_ENABLED=false
# 신규 연동은 API HUB 자격증명을 우선 사용
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=


# ----- Toss Payments (결제) --------------------
# 프리미엄 구독/결제 기능 쓸 때만 필요
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ----- 관측성 (Week1: Sentry 에러 추적 + PostHog 퍼널) -----
# 미설정 시 둘 다 자동 no-op
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
# Fail closed. Enabling this flag still does not load PostHog until the browser
# holds the current explicit analytics-consent grant.
NEXT_PUBLIC_POSTHOG_ENABLED=false

# ----- 아모라 비용 가드레일 (유통 테스트 전 지갑 보호) -----
# 코드의 미설정 기본값은 보수적으로 커플당 100, 전역 일일 300입니다.
# 긴급 상황에서도 AMORA_COST_GUARD_ENABLED는 운영 승인 없이 끄지 않습니다.
AMORA_COST_GUARD_ENABLED=true
AMORA_COUPLE_QUOTA_ENABLED=true
AMORA_FREE_MESSAGES_PER_COUPLE=100
AMORA_DEMO_GLOBAL_DAILY_MESSAGE_CAP=60
AMORA_GLOBAL_DAILY_MESSAGE_CAP=300
AMORA_GLOBAL_DAILY_COST_CAP_USD=20

# ----- Cloudflare Turnstile (가입 봇 차단) -----
# 미설정 시 자동 no-op (위젯 미노출 + 서버 검증 스킵). 둘 다 넣어야 활성화.
# 발급: Cloudflare 대시보드 → Turnstile → Add site (도메인 hanbang.ai)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── 사업자 식별 정보 (개인정보처리방침 하단 노출) ───────────────────
# 상호와 사업자등록번호가 모두 채워져야 화면에 나타난다. 비어 있으면 섹션 자체가
# 렌더되지 않는다 — 없는 값을 자리표시자로 띄우면 그게 곧 허위 표시이기 때문.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=
NEXT_PUBLIC_BUSINESS_REPRESENTATIVE=
NEXT_PUBLIC_BUSINESS_MAIL_ORDER_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_CONTACT_PHONE=
