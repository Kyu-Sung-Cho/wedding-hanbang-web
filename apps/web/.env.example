# =============================================
# 웨딩한방 웹 환경변수 샘플
# =============================================
# .env.local 로 복사 후 실제 값으로 채워 사용:
#   cp .env.example .env.local
# NEXT_PUBLIC_* 접두사가 붙은 값만 브라우저로 노출됩니다.
# =============================================


# ----- Supabase (필수) -------------------------
# 공유 Supabase 프로젝트 (모바일 앱과 동일)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
# Service Role 키 — RLS 우회용. 브라우저에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...


# ----- 도메인 / 사이트 URL ---------------------
# OAuth 콜백, 이메일 발송 시 링크에 사용
NEXT_PUBLIC_SITE_URL=https://hanbang.ai


# ----- Anthropic Claude (필수) -----------------
# AI 채팅(아모라), 대본 생성, 커뮤니티 AI 댓글
ANTHROPIC_API_KEY=sk-ant-xxx...


# ----- Resend (사전등록 / 가입 확인 메일) -----
# 없어도 앱은 동작 (이메일 발송만 skip)
RESEND_API_KEY=re_xxx...


# ----- Launch 모드 -----------------------------
# "coming_soon" 이면 랜딩만 노출되고 로그인/앱 접근 차단
# 그 외 값(또는 미설정) — 정상 서비스 모드
NEXT_PUBLIC_LAUNCH_MODE=


# ----- 관리자 페이지 비밀번호 ------------------
# /admin 접속 시 요구
ADMIN_PASSWORD=


# ----- 아모라 서비스 계정 ID (커뮤니티 AI 댓글용)
# 서버: 커뮤니티 AI 댓글 작성자 ID
AMORA_SERVICE_USER_ID=00000000-0000-0000-0000-000000000000
# 클라이언트: 커뮤니티에서 아모라 유저 판별용
NEXT_PUBLIC_AMORA_USER_ID=00000000-0000-0000-0000-000000000000


# ----- Naver OpenAPI (업체 탐색 보조) ----------
# 선택. 없어도 기본 DB 검색은 동작
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


# ----- Toss Payments (결제) --------------------
# 프리미엄 구독/결제 기능 쓸 때만 필요
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
