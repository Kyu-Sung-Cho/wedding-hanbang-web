# =============================================
# 웨딩한방 웹 환경변수 샘플
# =============================================
# .env.local 로 복사 후 실제 값으로 채워 사용:
#   cp .env.example .env.local
# NEXT_PUBLIC_* 접두사가 붙은 값만 브라우저로 노출됩니다.
# =============================================


# ----- Supabase (필수) -------------------------
# 공유 Supabase 프로젝트 (모바일 앱과 동일)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
# Service Role 키 — RLS 우회용. 브라우저에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# ----- 서버 작업 인증 (필수) -------------------
# Vercel Cron이 계정 삭제 영속 큐를 처리할 때 사용하는 서버 전용 Bearer secret.
# 미설정 시 워커는 fail-closed(401)하며 어떤 삭제 job도 claim하지 않습니다.
# 예: openssl rand -base64 48
CRON_SECRET=replace-with-a-long-random-secret


# ----- 도메인 / 사이트 URL ---------------------
# OAuth 콜백, 이메일 발송 시 링크에 사용
NEXT_PUBLIC_SITE_URL=https://hanbang.ai

# ----- 운영 maintenance (배포 창에서만) --------
# true인 배포는 정적 리소스와 /maintenance, /api/health/maintenance만 열고
# 그 밖의 페이지·API를 503으로 닫습니다. 평상시에는 false입니다.
MAINTENANCE_MODE=false
# maintenance 배포를 만든 UTC ISO-8601 시각. true일 때 필수이며 임의의 과거
# 시각을 재사용하지 않습니다. 예: 2026-07-11T17:30:00Z
MAINTENANCE_STARTED_AT_UTC=

# ----- 계정 없는 예시 앱 (production 필수) -----
# 예시 세션 쿠키 HMAC 전용 비밀값. production에서 미설정 시 예시 앱 시작은 fail-closed합니다.
DEMO_SESSION_SECRET=replace-with-a-separate-32-character-random-secret


# ----- OpenAI GPT (필수) -----------------------
# API key는 OpenAI 프로젝트/Vercel secret에만 저장하고 Git에 커밋하지 않습니다.
OPENAI_API_KEY=sk-proj-xxx...
# primary(Terra): 계약·분쟁/안전·반복 수정 승격 / fast(Luna): 일반 아모라 채팅
OPENAI_AMORA_PRIMARY_MODEL=gpt-5.6-terra
OPENAI_AMORA_FAST_MODEL=gpt-5.6-luna
# 비용 절약 기본값. 계정의 모델 지원 범위와 품질 평가 후에만 올리세요.
OPENAI_AMORA_PRIMARY_REASONING_EFFORT=none
OPENAI_AMORA_FAST_REASONING_EFFORT=none
# Terra/Luna 장문·고비용 입력을 조기에 차단 (1,000~48,000, 코드 상한 48,000)
AMORA_MAX_INPUT_TOKENS=48000
# 비용 가드는 production에서 끌 수 없습니다. 배포별 숫자는 코드/DB 하드 상한보다 낮출 때만 반영됩니다.
AMORA_COST_GUARD_ENABLED=true
AMORA_FREE_MESSAGES_PER_COUPLE=30
# exact input count와 이어지는 generation을 한 slot으로 묶은 전체 일일 상한. 커플별 일일 상한은 DB 계약상 20입니다.
AMORA_GLOBAL_DAILY_PROVIDER_CALL_CAP=60
# 요청/대화 원문 hash의 offline 대조를 막는 32자 이상 서버 전용 HMAC 키
AMORA_IDEMPOTENCY_SECRET=replace-with-at-least-32-random-characters
# IP·이메일·사용자 ID가 rate-limit DB에 원문으로 남지 않게 하는 전용 HMAC 키
RATE_LIMIT_KEY_SECRET=replace-with-another-32-character-random-secret
# 요약/결정/프로필 background Luna 작업은 현재 채팅 경로에서 코드로 hard-off입니다.

# 로컬 테스트 전용. production에서는 코드가 항상 fail-closed로 강제합니다.
AMORA_COST_GUARD_FAIL_OPEN=false
# hard-off 보조 경로를 재설계할 때만 검토할 레거시 설정입니다. 현재 값을 true로 바꿔도 호출되지 않습니다.
AMORA_EXCAVATION_CLASSIFICATION_ENABLED=false

# ----- Amora profile memory ---------------------
# hard-off 보조 경로의 레거시 설정. 재활성화 전 별도 개인정보·비용 검토가 필요합니다.
AMORA_PROFILE_MEMORY_MODE=conservative


# ----- Resend (사전등록 / 가입 확인 메일) -----
# 없어도 앱은 동작 (이메일 발송만 skip)
RESEND_API_KEY=re_xxx...


# ----- Launch 모드 -----------------------------
# "coming_soon" 이면 랜딩만 노출되고 로그인/앱 접근 차단
# 그 외 값(또는 미설정) — 정상 서비스 모드
NEXT_PUBLIC_LAUNCH_MODE=


# ----- 관리자 페이지 비밀번호 ------------------
# /admin 접속 시 요구
ADMIN_PASSWORD=


# ----- 아모라 서비스 계정 ID (비활성 커뮤니티 AI 댓글의 레거시 호환용)
# 현재 커뮤니티 AI 댓글 생성은 비용·신뢰 경계 때문에 비활성입니다.
# 서버: 과거 커뮤니티 AI 댓글 작성자 ID
AMORA_SERVICE_USER_ID=00000000-0000-0000-0000-000000000000
# 클라이언트: 커뮤니티에서 아모라 유저 판별용
NEXT_PUBLIC_AMORA_USER_ID=00000000-0000-0000-0000-000000000000


# ----- Naver OpenAPI (업체 탐색 보조) ----------
# 선택. 없어도 기본 DB 검색은 동작
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


# ----- Toss Payments (결제) --------------------
# 프리미엄 구독/결제 기능 쓸 때만 필요
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ----- 관측성 (법무/DPA/리전/보유기간 승인 전 코드 하드 비활성) -----
# 미설정 시 둘 다 자동 no-op
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----- Cloudflare Turnstile (가입 봇 차단) -----
# 미설정 시 자동 no-op (위젯 미노출 + 서버 검증 스킵). 둘 다 넣어야 활성화.
# 발급: Cloudflare 대시보드 → Turnstile → Add site (도메인 hanbang.ai)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
