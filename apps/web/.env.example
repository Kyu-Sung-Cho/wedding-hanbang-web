# =============================================
# 웨딩한방 웹 환경변수 샘플
# =============================================
# .env.local 로 복사 후 실제 값으로 채워 사용:
#   cp .env.example .env.local
# NEXT_PUBLIC_* 접두사가 붙은 값만 브라우저로 노출됩니다.
# =============================================


# ----- Supabase (필수) -------------------------
# 공유 Supabase 프로젝트 (모바일 앱과 동일)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
# Production build gate: exact distinct approved-vendor count and SHA-256 of
# UTF-8 JSON.stringify(the ordinal-sorted unique vendor_slug list). Both are
# release evidence, not operator-chosen safety margins; leave blank otherwise.
PRICE_CATALOG_EXPECTED_PUBLISHED_VENDOR_COUNT=
PRICE_CATALOG_EXPECTED_PUBLISHED_VENDOR_SLUGS_SHA256=
# 소유자 서명 배포 게이트. `supabase/release-manifests/vendor-disclosure-v2-20260718.json`의
# 개행 정규화 SHA-256을 **소유자가 직접** 핀한다. VERCEL_ENV=production일 때만 검사하며,
# 값이 없으면 빌드가 fail-closed된다(`..._NOT_IMPLEMENTED`), 어긋나면 `..._INVALID`.
#
# ⚠️ 새 마이그레이션을 매니페스트에 등록하면 이 해시가 바뀐다. 순서를 지킬 것:
#    ① 새 sha256 계산 → ② 소유자가 Vercel에 재핀 → ③ push.
#    거꾸로 하면 프로덕션 빌드가 막힌다(사이트는 이전 배포가 계속 서비스돼 다운은
#    아니므로 알아채기 어렵다). 환경변수만 바꿔도 실패한 빌드는 자동 재시도되지
#    않으므로 빈 커밋으로 새 빌드를 걸어야 한다. 로컬·프리뷰에서는 비워 둔다.
VENDOR_DISCLOSURE_PRODUCTION_AUTHORIZATION=
# Service Role 키 — RLS 우회용. 브라우저에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...
# Supabase Management API 개인 액세스 토큰. 앱 런타임은 쓰지 않고 **운영 점검·릴리스
# 스크립트**가 쓴다(`audit:production`, 외부 게이트 증거 수집 등 10개 파일).
# 없으면 `pnpm audit:production`이 "SUPABASE_ACCESS_TOKEN이 .env.local에 없다"로 죽는다.
# 발급: Supabase Dashboard → Account → Access Tokens.
# 워크트리에서 비밀값을 형제 체크아웃에 두는 배치도 지원한다 — 감사 스크립트는
# **키가 든 파일**을 고른다(존재만 보고 첫 파일을 잡지 않는다).
SUPABASE_ACCESS_TOKEN=sbp_xxx...
# Service-role destination fence. The URL and ref are a singleton allowlist.
# For production runtime writes, the confirmation must exactly be
# RUNTIME_WRITE:<SUPABASE_PRODUCTION_PROJECT_REF>. It is not a secret.
SUPABASE_EXPECTED_URL=https://your-project-ref.supabase.co
SUPABASE_EXPECTED_PROJECT_REF=your-project-ref
# 가입 동의 서버 증빙 전환의 실제 UTC 시각(YYYY-MM-DDTHH:mm:ss.SSSZ).
# 운영 쓰기 차단 후 정식 rollout에서 한 번 확정한다. 예시 날짜를 복사하지 않는다.
# 미설정/잘못된 날짜/미래 시각은 production build를 차단한다.
# NEXT_PUBLIC/EXPO_PUBLIC로 복제하지 않으며 모바일은 서버 판정을 사용한다.
SIGNUP_CONSENT_LEGACY_BEFORE=
SUPABASE_PRODUCTION_PROJECT_REF=your-production-project-ref
# 운영 쓰기 확인 문자열. **로컬·프리뷰에서는 반드시 비워 둔다.**
#    운영 환경변수를 통째로 복사하면 이 값도 같이 복사되고, 그러면 개발 PC 의
#    `pnpm dev` 가 운영 DB 에 쓴다 — 실제로 그렇게 커플 기록이 상한 적이 있다.
#    2026-08-23 부터 런타임 쓰기는 배포된 서버(Vercel)에서만 통과하지만, 그건
#    마지막 문턱이지 첫 문턱이 아니다. 이 값을 로컬에 두지 않는 것이 첫 문턱이다.
SUPABASE_PRODUCTION_WRITE_CONFIRM=
# Required by every /api/cron/* route. Use a separate random production secret;
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
# Optional server-only credential for GET /api/ops/account-deletion-state only.
# Support CLI prefers this over CRON_SECRET; it never grants cron or deletion access.
# Keep distinct from CRON_SECRET. Do not prefix with NEXT_PUBLIC_ or send it in URLs.
ACCOUNT_DELETION_STATE_SECRET=
# External community reply delivery is staged and fail-closed. Keep false until
# hosted migration, explicit user opt-in, Expo, device, receipt, and canary evidence pass.
# The provider cron is intentionally absent from the default Vercel config.
# Add an approved schedule only after plan, hosted DB, Expo, and device evidence pass.
COMMUNITY_REPLY_PUSH_DELIVERY_ENABLED=false
# Server-only Expo access token used by the bounded community reply-push cron.
# Never expose this through NEXT_PUBLIC_* or the mobile bundle.
EXPO_ACCESS_TOKEN=
# HMAC key for pseudonymous rate-limit bucket identifiers. Use a distinct
# random value of at least 32 characters in production; rotating it resets
# active rate-limit windows.
RATE_LIMIT_KEY_SECRET=
# Separate secret for stable pseudonymous labels in the local cost report.
# Never reuse the service-role credential as an HMAC key.
AMORA_COST_REPORT_PSEUDONYM_KEY=
# 데모 쿠키 서명 전용 32바이트 이상 랜덤 비밀값. 운영에서는 다른 키의
# fallback에 기대지 말고 별도 값으로 설정합니다.
DEMO_SESSION_SECRET=
# Canonical internal server-to-server authentication for Amora vendor lookup,
# recommendation, and evidence profile APIs. Use a distinct random value of at
# least 32 characters; send it only as `X-Internal-Token` and never expose it to
# a browser bundle.
INTERNAL_API_TOKEN=
# Legacy deployment compatibility only. Prefer leaving this unset. If both
# variables are present they must be identical, otherwise requests fail closed.
VENDOR_INTERNAL_TOKEN=

# Preview-only fail-closed mode. Set true only in Vercel Preview.
# It disables public landing Supabase effects and returns 503 for every /api/* request,
# even if live Supabase variables are accidentally injected. Never enable in Production.
NEXT_PUBLIC_PREVIEW_STUB_MODE=false


# ----- 도메인 / 사이트 URL ---------------------
# OAuth 콜백, 이메일 발송 시 링크에 사용
NEXT_PUBLIC_SITE_URL=https://hanbang.ai


# ----- WeddingCode local research preview -----
# Local development only. The route also requires NODE_ENV=development and
# stays 404 in Preview/Production. It performs no network or browser storage.
WEDDING_CODE_RESEARCH_PREVIEW=false

# Wedding rollout controls are server-only and fail closed. Only exact `true`
# enables either surface; keep both false until their release gates pass.
WEDDING_COURT_ENABLED=false
WEDDING_PAYMENT_LEDGER_ENABLED=false

# ----- Community emergency and beta controls -----
# Runtime incident mode. `normal` keeps normal traffic, `read_only` blocks
# ordinary mutations, and `disabled` closes the community surface while safety
# intake remains available. Keep this explicit and coordinate it with the
# database runtime control described in the operations runbook.
COMMUNITY_RUNTIME_MODE=normal
# Controlled beta ships text-only. Media upload, finalize, and media-bearing
# post creation stay fail-closed unless the exact value `true` is approved.
COMMUNITY_MEDIA_PUBLISHING_ENABLED=false
# Browser affordances use a separate public hint and also require exact `true`.
# This never grants publish permission; the server flag above remains final.
NEXT_PUBLIC_COMMUNITY_MEDIA_PUBLISHING_ENABLED=false


# ----- OpenAI GPT-5.6 (필수) --------------------
# AI 채팅(아모라)과 서버의 AI 보조 기능에 사용합니다.
# 운영 안전 게이트를 모두 통과하기 전에는 false로 유지합니다.
# 키만 등록해도 자동 활성화되지 않습니다.
AMORA_OPENAI_ENABLED=false
# Extra summarization/profile/extraction calls are disabled by default to avoid
# hidden fan-out cost. Enable only after a queued worker and separate budget exist.
AMORA_AUXILIARY_MEMORY_ENABLED=false
# Proactive care email is a separate external side effect and stays off until
# roster-churn and delivery canaries pass.
AMORA_CARE_OUTBOUND_ENABLED=false
# Hall inquiry letters (2026-11-17 design). Approvals are saved, but nothing is
# queued to the operator until this is exactly "true". Turning it on in production
# is a separate founder decision (D-19, plus vendor cooperation, e-commerce status
# and terms). Daily cap is per couple per Korean day; an invalid value counts as 0.
# The global cap counts every couple's queued inquiries per Korean day and fails
# closed: missing or invalid means nothing is queued. Approvals given while sending
# is off never queue later; a fresh approval is needed once it is on.
HALL_INQUIRY_SENDING_ENABLED=false
HALL_INQUIRY_DAILY_CAP=5
HALL_INQUIRY_GLOBAL_DAILY_CAP=0
# In-app proactive care (Amora speaks first inside the chat) is a separate switch
# from the email side effect above. It has no external delivery, so it can be
# enabled on its own; the whole moment loop stays silent while this is false.
AMORA_PROACTIVE_CHAT_ENABLED=false
# Community auto-comments are a separate public side effect. Keep them off until
# moderation, cost, and deletion canaries have passed.
AMORA_COMMUNITY_AI_COMMENT_ENABLED=false
# Conversation-segment schema is additive, but provider reads must keep using
# the legacy path until dual-write, backfill, shadow-read, restore, and canary
# evidence are complete. Only the exact value `true` enables the cutover;
# missing or malformed values stay off. Enabled reads fail closed with 503 when
# the active lane cannot be proved. Rollback disables only the new read path.
AMORA_CONVERSATION_SEGMENT_READ_ENABLED=false

# 숨은 자동 갈등 감지/중재는 제품 계약상 비활성입니다. 로컬 회귀 평가 외에는
# true로 설정하지 않으며, production에서는 코드가 true도 강제로 거부합니다.
AMORA_AUTOMATIC_CONFLICT_MEDIATION_ENABLED=false
# TodayOne is an opt-in, in-app-only care surface. Keep the rollout off until
# its migrations, couple-bound preference/receipt checks, fairness regressions,
# restore rehearsal, and canary evidence are complete. Only exact `true` opens it.
AMORA_TODAY_ONE_ENABLED=false
# Destructive raw-log retention stays off until the 90-day policy, backup,
# restore rehearsal, and production canary have explicit approval.
AI_LOG_RETENTION_CRON_ENABLED=false
# WeddingCode research contributions (opt-in answer letters, no account, 60-day TTL).
# Two switches, on purpose:
# - WEDDING_CODE_RESEARCH_RECEIPT_SECRET (32+ chars, never reuse another secret) keeps
#   the STORAGE duties on: daily retention cron, delete endpoint/form, privacy notice.
#   Set it only after the `wedding-code-research-contributions` DB lane is applied.
#   Do NOT remove or rotate it while contributions may exist (until 60 days after the
#   last one): receipts are HMAC-ed with it, so a new secret orphans every receipt.
# - WEDDING_CODE_RESEARCH_CONTRIBUTION_ENABLED=true additionally accepts NEW answers
#   (consent card + POST), and only after WEDDING_CODE_RESEARCH_CONTRIBUTION_EFFECTIVE_AT.
#   To stop collecting, set only this back to false.
WEDDING_CODE_RESEARCH_CONTRIBUTION_ENABLED=false
WEDDING_CODE_RESEARCH_RECEIPT_SECRET=
# Account-deletion intake is a separate fail-closed boundary. Keep both intake
# and progression off until shared-media policy, legal retention, completion
# notification, backup replay, and the manual-review owner/SLA are approved.
ACCOUNT_DELETION_INTAKE_ENABLED=false
ACCOUNT_DELETION_CRON_ENABLED=false
# Temporary release-maintenance gate. Exact `true` returns 503 for unsafe
# /api methods. Keep false normally; enable and redeploy before the final backup.
PRODUCTION_WRITE_FENCE_ENABLED=false
OPENAI_API_KEY=
OPENAI_AMORA_PRIMARY_MODEL=gpt-5.6-terra
OPENAI_AMORA_FAST_MODEL=gpt-5.6-luna
OPENAI_AMORA_PRIMARY_REASONING_EFFORT=none
OPENAI_AMORA_FAST_REASONING_EFFORT=none
# Authenticated release-conversation evaluation only. Use a distinct random
# server/operator secret of at least 32 characters. Store it in Vercel/CI or a
# password manager; never expose it through NEXT_PUBLIC_* or commit the value.
AMORA_EVAL_SECRET=

# ----- Amora profile memory ---------------------
# off: disabled / conservative: explicit preferences only / full: includes sensitive fields
AMORA_PROFILE_MEMORY_MODE=conservative


# ----- Resend (사전등록 / 가입 확인 메일) -----
# 없어도 앱은 동작 (이메일 발송만 skip)
RESEND_API_KEY=re_xxx...


# ----- Launch 모드 (2026-08-29 없앰) -----------------------------
# `NEXT_PUBLIC_LAUNCH_MODE` 가 여기 있었다. 파운더 결정으로 지웠다.
#
# 두 가지가 사실이 아니었다.
#  1. 설명이 "coming_soon 이면 랜딩만 노출되고 로그인/앱 접근 차단" 이라고 했지만,
#     코드는 **주 버튼 글자만** 바꿨다("시작하기" → "미리 체험하기"). 아무것도 막지 않았다.
#  2. 그 값이 **운영에 켜져 있었다.** 2026-08-29 라이브 실측으로 `/about` 이 실제로
#     "미리 체험하기" 를 띄우는 것을 확인했다.
#
# "베타" 라는 낱말은 없지만 "아직 정식이 아니다" 라는 같은 틀이고, 계정은 그냥 만들 수
# 있는 것이다(CLAUDE.md 2026-08-29). env 를 끄는 대신 **분기를 코드에서 뺐다** —
# env 는 다시 켜질 수 있지만 읽는 곳이 없으면 아무 일도 일어나지 않는다.
#
# Vercel 에 남아 있는 값은 이제 참조 0건이라 무해하다. 지우려면 파운더가 직접 하면 된다.

# 로그인 없는 아모라 체험을 열지 여부. 비우면 **닫힘**(2026-08-27 파운더 결정).
# 닫는 이유: 체험 대화가 실사용자와 같은 지갑을 쓰는데, 운영 실측으로 5주간
# 89턴 · $1.55 뿐이었고 데려온 사람의 증거가 없었다. 인증 없이 LLM 을 쓰는
# 경로를 공개 표면에 열어 둘 값이 아니다. `/demo` 설명 페이지는 그대로 열려 있다.
# 켜려면 true. 릴리스 평가기(X-Amora-Eval)는 이 값과 무관하게 통과한다.
NEXT_PUBLIC_DEMO_TRIAL_ENABLED=


# ----- 관리자 페이지 비밀번호 ------------------
# /admin 접속 시 요구
ADMIN_PASSWORD=


# ----- 아모라 서비스 계정 ID (커뮤니티 AI 댓글용)
# 서버: 커뮤니티 AI 댓글 작성자 ID
AMORA_SERVICE_USER_ID=00000000-0000-0000-0000-000000000000
# 클라이언트: 커뮤니티에서 아모라 유저 판별용
NEXT_PUBLIC_AMORA_USER_ID=00000000-0000-0000-0000-000000000000


# ----- NAVER API HUB (장소/사진 검색) -----
# 서버 전용. 신규 연동은 API HUB 자격증명을 우선 사용
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=


# ----- Toss Payments (결제) --------------------
# 프리미엄 구독/결제 기능 쓸 때만 필요
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ----- 관측성 (Week1: Sentry 에러 추적 + PostHog 퍼널) -----
# 미설정 시 둘 다 자동 no-op
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----- 아모라 비용 가드레일 (유통 테스트 전 지갑 보호) -----
# 코드의 미설정 기본값은 보수적으로 커플당 100, 전역 일일 300입니다.
# 현재 베타는 커플별 한도만 해제하고 전역 일일·비용 상한은 계속 유지합니다.
# 긴급 상황에서도 AMORA_COST_GUARD_ENABLED는 운영 승인 없이 끄지 않습니다.
AMORA_COST_GUARD_ENABLED=true
AMORA_COUPLE_QUOTA_ENABLED=false
AMORA_FREE_MESSAGES_PER_COUPLE=100
AMORA_GLOBAL_DAILY_MESSAGE_CAP=300
AMORA_GLOBAL_DAILY_COST_CAP_USD=20
# 기준 시각(기본 2026-10-20) 이전에 만들어진 커플이 하루에 쓸 수 있는 상담 턴의 천장입니다. AMORA_COUPLE_DAILY_CAP + 5 아래로는 내려가지 않습니다.
# AMORA_GRANDFATHERED_COUPLE_DAILY_CAP=80
# 팀 테스트 계정만 채팅 횟수·비용 한도 면제. Supabase Auth UUID를 쉼표로 구분.
# 관리자 권한은 부여하지 않으며 AI 로그·예약·정산은 유지. 미설정이면 면제 없음.
AMORA_TEST_USER_IDS=

# ----- Cloudflare Turnstile (가입 봇 차단) -----
# 미설정 시 자동 no-op (위젯 미노출 + 서버 검증 스킵). 둘 다 넣어야 활성화.
# 발급: Cloudflare 대시보드 → Turnstile → Add site (도메인 hanbang.ai)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----- 소셜 로그인 버튼 노출 (lib/auth/oauthProviders.ts) -----
# 눌러도 동작하지 않는 버튼은 없는 것보다 나쁘다. Supabase Auth 에서 실제로
# 켜진 provider 만 화면에 남긴다.
#
# 카카오: 2026-08-22 운영 실측에서 authorize 가 400 "provider is not enabled"
#   를 냈다. **명시적으로 "true" 를 넣어야만** 버튼이 보인다.
#   켜는 순서 = Kakao Developers 앱 설정 → Supabase Auth 에서 Kakao 활성화 →
#   여기에 true → **재배포**. 그 전에 켜면 첫 자리 버튼이 오류를 낸다.
#   NEXT_PUBLIC_ 값은 빌드 시점에 번들로 박히므로 값만 바꾸면 반영되지 않는다.
#   이 프로젝트는 env 변경으로 재빌드가 걸리지 않으니 빈 커밋으로 새 빌드를 건다.
NEXT_PUBLIC_KAKAO_OAUTH_ENABLED=
# Google·Apple: 운영에서 동작이 확인됐으므로 **기본 켜짐**. 비워 두면 보인다.
# 운영에서 꺼질 때 "false" 로 즉시 숨긴다(빈 값과 false 는 다르다).
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=
NEXT_PUBLIC_APPLE_OAUTH_ENABLED=

# ── 사업자 식별 정보 (개인정보처리방침 하단 노출) ───────────────────
# 상호와 사업자등록번호가 모두 채워져야 화면에 나타난다. 비어 있으면 섹션 자체가
# 렌더되지 않는다 — 없는 값을 자리표시자로 띄우면 그게 곧 허위 표시이기 때문.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=
NEXT_PUBLIC_BUSINESS_REPRESENTATIVE=
NEXT_PUBLIC_BUSINESS_MAIL_ORDER_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_CONTACT_PHONE=

# ── 앱 딥링크 증명서 (/.well-known) ────────────────────────────────
# 초대 QR·링크(https://hanbang.ai/invite#WH-...)를 찍었을 때 웹이 아니라 앱이 열리게
# 하는 두 파일이다. 값이 비어 있으면 두 라우트는 **404**를 낸다 — 빈 파일이나 가짜 값을
# 서빙하면 OS가 검증에 실패한 뒤 한동안 재시도하지 않아서, 아무것도 없을 때보다 나쁘다.
#
# iOS: Apple Developer 계정의 Team ID(10자 영숫자). Membership 페이지에서 확인한다.
#      appID는 `<TEAM_ID>.ai.hanbang.wedding`으로 조립된다.
APPLE_APP_SITE_ASSOCIATION_TEAM_ID=
# Android: 앱 서명 인증서의 SHA-256 지문(콜론으로 이은 32바이트, 대문자).
#          Play 앱 서명을 쓰면 **릴리스 키와 업로드 키를 둘 다** 넣어야 한다.
#          쉼표나 공백으로 여러 개를 적을 수 있고, 하나라도 모양이 다르면 전체가 거절된다.
#          확인: Play Console → 설정 → 앱 서명, 또는 `keytool -list -v -keystore <파일>`
ANDROID_APP_LINKS_SHA256_CERT_FINGERPRINTS=
# 중립 준비 공간: 온보딩에서 신부/신랑 역할을 묻지 않고 한 화면에서 시작한다.
# 켜기 전에 20260812030000·20260816180000·20260818110000 마이그레이션이 적용돼
# 있어야 한다(create_neutral_preparation_space_for_current_user 등이 그 안에 있다).
AMORA_NEUTRAL_PREPARATION_SPACE_ENABLED=false
