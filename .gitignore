# ─────────────────────────────────────
# Monorepo root .gitignore
# ─────────────────────────────────────

# Dependencies (모든 워크스페이스)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
**/.next/
**/out/
**/dist/
**/build/
**/.expo/
**/.expo-shared/
**/web-build/
**/.turbo

# Testing
coverage
*.lcov

# Env files (never commit)
.env

# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json
.env.*
!.env.example

# Typescript
*.tsbuildinfo
**/next-env.d.ts

# Vercel
.vercel
apps/*/.vercel

# Supabase
supabase/.temp/
supabase/.branches/

# Expo/Mobile
apps/mobile/.expo/
apps/mobile/.metro-cache/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/*.jks
apps/mobile/*.p8
apps/mobile/*.p12
apps/mobile/*.key
apps/mobile/*.mobileprovision
apps/mobile/*.orig.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
*.pem

# IDE
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Misc
.cache
.gstack/

# QA/디자인 세션 스크린샷 산출물 (apps/web 루트에 생성됨 — 커밋 금지)
apps/web/*.png
apps/web/.screenshots/
apps/web/.screenshots-test/
test-results/
apps/web/src/app/internal/wedding-code-research/page.tsx
apps/web/.wedding-code-research.lock
.env*

# 공시 원본 및 적재 파이프라인 로컬 산출물 (개인/업체 원문 커밋 금지)
data/raw/
scripts/ingest/.state/
# 아래 항목은 이전 기본 state 위치를 사용한 로컬 작업물도 계속 차단한다.
scripts/ingest/.converted/
scripts/ingest/.cache/
scripts/ingest/validated/
scripts/ingest/manifest.json
