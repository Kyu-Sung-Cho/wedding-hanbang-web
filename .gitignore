# ─────────────────────────────────────
# Monorepo root .gitignore
# ─────────────────────────────────────

# Dependencies (모든 워크스페이스)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
**/.next/
**/out/
**/dist/
**/build/
**/.expo/
**/.expo-shared/
**/web-build/
**/.turbo

# Testing
coverage
*.lcov

# Env files (never commit)
.env
.env.*
!.env.example

# Typescript
*.tsbuildinfo
**/next-env.d.ts

# Vercel
.vercel
apps/*/.vercel

# Supabase
supabase/.temp/
supabase/.branches/

# Expo/Mobile
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/*.jks
apps/mobile/*.p8
apps/mobile/*.p12
apps/mobile/*.key
apps/mobile/*.mobileprovision
apps/mobile/*.orig.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
*.pem

# IDE
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Misc
.cache
